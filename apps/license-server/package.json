    "fastify": "5.12.5",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "^24.0.0",
    "tsx": "latest",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
